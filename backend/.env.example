# Copy to backend/.env (gitignored) and adjust. Never commit a real .env.

# PostgreSQL connection string. The driver is psycopg 3.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/webloom_sales_engine

# The database the test suite uses. Its name must end in "_test" — the suite
# refuses to run against anything else. Never point this at a shared database.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/webloom_sales_engine_test

# "development" (default) or "test". "production" makes the seed refuse to run.
ENVIRONMENT=development

# Log every SQL statement (noisy; off by default).
SQL_ECHO=false
