# Copy to backend/.env (gitignored) and adjust. Never commit a real .env.

# PostgreSQL connection string. The driver is psycopg 3.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/webloom_sales_engine

# The database the test suite uses. Its name must end in "_test" — the suite
# refuses to run against anything else. Never point this at a shared database.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/webloom_sales_engine_test

# "development" (default) or "test". "production" makes the seed refuse to run.
ENVIRONMENT=development

# Log every SQL statement (noisy; off by default).
SQL_ECHO=false

# ---- Sprint 3: authentication -----------------------------------------------

# Signing key for access tokens. The value below is a development placeholder:
# replace it anywhere real, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-change-me-before-anything-real

# How long an access token stays valid, in minutes. 480 = 8 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Temporary password for the four team administrators created by
# `python -m app.bootstrap`. Required only for that command. Never commit a
# real value and never reuse it outside local development.
BOOTSTRAP_ADMIN_PASSWORD=
