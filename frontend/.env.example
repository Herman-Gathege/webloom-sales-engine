# Copy to frontend/.env.local and change what you need. Never commit a real .env.local.

# Base URL the client appends "/leads" to, so it must include the version prefix.
# Leave this unset in development: the default is "/api/v1" and Vite proxies /api
# to the API, so there is no CORS to arrange. Setting it to a bare host such as
# "http://localhost:8000" would call http://localhost:8000/leads and miss /api/v1.
# VITE_API_BASE_URL=/api/v1

# Where the dev server proxies "/api" to. Change this if the API runs elsewhere.
# VITE_API_PROXY_TARGET=http://localhost:8000

# Set to "1" to skip the API entirely and always use the bundled sample leads.
# Leave it unset to call the real API and fall back to sample data only if it
# cannot be reached — the app says which one you are looking at either way.
# VITE_USE_MOCK=1
